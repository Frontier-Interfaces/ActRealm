{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontierinterfaces.example/schemas/runtime-diagnostics-v2.json",
  "title": "ActRealm Runtime Diagnostics v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "instanceId",
    "pid",
    "version",
    "commit",
    "protocolVersion",
    "startedAt",
    "uptimeMs",
    "api",
    "websocket",
    "hook",
    "sessions",
    "snapshot",
    "attention",
    "storage",
    "collectors",
    "companion",
    "conditional",
    "restart"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0
    },
    "instanceId": {
      "type": "string",
      "format": "uuid"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "commit": {
      "type": "string",
      "pattern": "^(unknown|[0-9A-Fa-f]{40})$"
    },
    "protocolVersion": {
      "const": 2
    },
    "startedAt": {
      "type": "integer",
      "minimum": 0
    },
    "uptimeMs": {
      "type": "integer",
      "minimum": 0
    },
    "api": {
      "$ref": "#/$defs/service"
    },
    "websocket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "connections"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "unavailable"
          ]
        },
        "connections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "name",
        "private",
        "lastEventAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "insecure",
            "missing",
            "invalid",
            "unavailable"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "private": {
          "type": "boolean"
        },
        "lastEventAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "sessions": {
      "$ref": "#/$defs/sessionCounts"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "revisionSource",
        "lastEventAt",
        "freshness"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "revisionSource": {
          "const": "runtime:sqlite_event_count"
        },
        "lastEventAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "freshness": {
          "enum": [
            "live",
            "delayed",
            "stale",
            "invalid",
            "unavailable"
          ]
        }
      }
    },
    "attention": {
      "$ref": "#/$defs/attentionCounts"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eventCount",
        "schemaVersion",
        "expectedSchemaVersion",
        "integrity",
        "checkedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "degraded",
            "unavailable"
          ]
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "expectedSchemaVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "integrity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "checkedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "collectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review",
        "token"
      ],
      "properties": {
        "review": {
          "$ref": "#/$defs/reviewCollector"
        },
        "token": {
          "$ref": "#/$defs/tokenCollector"
        }
      }
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "protocolVersion",
        "registrations",
        "scopes"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "unavailable"
          ]
        },
        "protocolVersion": {
          "const": 2
        },
        "registrations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "scopes": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "snapshot.read",
              "session.jump",
              "attention.respond"
            ]
          }
        }
      }
    },
    "conditional": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claudeCowork"
      ],
      "properties": {
        "claudeCowork": {
          "$ref": "#/$defs/conditionalFeature"
        }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "lastResult"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "lastResult": {
          "enum": [
            "recovered",
            "not_restarted"
          ]
        }
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "address"
      ],
      "properties": {
        "status": {
          "const": "ready"
        },
        "address": {
          "type": "string",
          "pattern": "^(127\\.0\\.0\\.1|\\[::1\\]):[0-9]{1,5}$"
        }
      }
    },
    "sessionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "total"
      ],
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "attentionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending",
        "waiters"
      ],
      "properties": {
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "waiters": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reviewCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "gitCheck",
        "pendingBaselines",
        "inProgress",
        "consecutiveFailures",
        "lastSuccessfulAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "scanning",
            "pending",
            "degraded"
          ]
        },
        "source": {
          "const": "runtime:review_baseline_queue"
        },
        "gitCheck": {
          "const": "on_demand"
        },
        "pendingBaselines": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "inProgress": {
          "type": "boolean"
        },
        "consecutiveFailures": {
          "type": "integer",
          "minimum": 0
        },
        "lastSuccessfulAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "tokenCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "dataQuality",
        "inProgress",
        "historyComplete",
        "consecutiveFailures",
        "lastSuccessfulAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "scanning",
            "pending",
            "partial",
            "unavailable"
          ]
        },
        "source": {
          "const": "runtime:canonical_session_ledger"
        },
        "dataQuality": {
          "enum": [
            "verified",
            "rebuilding",
            "pending",
            "partial",
            "unavailable"
          ]
        },
        "inProgress": {
          "type": "boolean"
        },
        "historyComplete": {
          "type": "boolean"
        },
        "consecutiveFailures": {
          "type": "integer",
          "minimum": 0
        },
        "lastSuccessfulAt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "conditionalFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "countsAsFault",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "paused",
            "unsupported",
            "not_enabled"
          ]
        },
        "countsAsFault": {
          "const": false
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]{1,64}$"
        }
      }
    }
  }
}
